# Copy to .env and edit:  cp .env.example .env

# REQUIRED: long random string used to sign login tokens.
#   generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

POSTGRES_PASSWORD=ginhawa

# No user accounts: anyone can view the app. The team signs in under Settings -> Team admin with
# this passcode to rename stations, set alert thresholds and remove stations. Share it only in the team.
ADMIN_PASSCODE=change-me-team-passcode

# Team secret built into the station firmware (ENROLL_SECRET in config.h). A station that knows it
# adds itself to the app the first time it is switched on. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ENROLL_SECRET=change-me-long-random-team-secret

# Where the app is served. For phones / the ESP32 on the same Wi-Fi, add your laptop's LAN IP:
#   SITE_ADDRESS=localhost, 192.168.1.20
#   DEFAULT_SNI=192.168.1.20
SITE_ADDRESS=localhost
DEFAULT_SNI=localhost

# "internal" = self-signed local CA. For a real domain set SITE_ADDRESS=your.domain and
# CADDY_TLS=you@example.com to get a free Let's Encrypt certificate.
CADDY_TLS=internal

TZ_NAME=Asia/Manila

# Copy to .env and edit:  cp .env.example .env

# REQUIRED: long random string used to sign login tokens.
#   generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

POSTGRES_PASSWORD=ginhawa

# Where the app is served. For phones / the ESP32 on the same Wi-Fi, add your laptop's LAN IP:
#   SITE_ADDRESS=localhost, 192.168.1.20
#   DEFAULT_SNI=192.168.1.20
SITE_ADDRESS=localhost
DEFAULT_SNI=localhost

# "internal" = self-signed local CA. For a real domain set SITE_ADDRESS=your.domain and
# CADDY_TLS=you@example.com to get a free Let's Encrypt certificate.
CADDY_TLS=internal

TZ_NAME=Asia/Manila

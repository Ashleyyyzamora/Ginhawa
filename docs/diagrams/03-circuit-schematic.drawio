xGeometry relative="1" as="geometry"><mxPoint x="1450" y="350" as="sourcePoint"/><mxPoint x="1420" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c97" value="+5V" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;html=1;fontSize=10;fontStyle=1;fillColor=#fff2cc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1382" y="340" width="38" height="20" as="geometry"/></mxCell><mxCell id="c98" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="380" as="sourcePoint"/><mxPoint x="1420" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c99" value="GND" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;html=1;fontSize=10;fontStyle=1;fillColor=#fff2cc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1382" y="370" width="38" height="20" as="geometry"/></mxCell><mxCell id="c100" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="480" as="sourcePoint"/><mxPoint x="1420" y="480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c101" value="GND" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;html=1;fontSize=10;fontStyle=1;fillColor=#fff2cc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1382" y="470" width="38" height="20" as="geometry"/></mxCell><mxCell id="c102" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="505" as="sourcePoint"/><mxPoint x="1432" y="505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c103" value="×" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1414" y="496" width="20" height="18" as="geometry"/></mxCell><mxCell id="c104" value="Sensirion SEN55&lt;br&gt;5 V ±10 %&lt;br&gt;I²C 0x69&lt;br&gt;SEL→GND selects I²C&lt;br&gt;pin 6: no connect" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1580" y="330" width="100" height="190" as="geometry"/></mxCell><mxCell id="c105" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="570" as="sourcePoint"/><mxPoint x="1230" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c106" value="" style="shape=mxgraph.electrical.resistors.resistor_2;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1230" y="562" width="70" height="16" as="geometry"/></mxCell><mxCell id="c107" value="R5 220 Ω" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1230" y="540" width="90" height="20" as="geometry"/></mxCell><mxCell id="c108" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="570" as="sourcePoint"/><mxPoint x="1340" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c109" value="" style="shape=mxgraph.electrical.opto_electronics.led_2;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1340" y="550" width="80" height="40" as="geometry"/></mxCell><mxCell id="c110" value="D1 LED red" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="528" width="120" height="20" as="geometry"/></mxCell><mxCell id="c111" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="570" as="sourcePoint"/><mxPoint x="1470" y="590" as="targetPoint"/><Array as="points"><mxPoint x="1470" y="570"/></Array></mxGeometry></mxCell><mxCell id="c112" value="" style="shape=mxgraph.electrical.signal_sources.signal_ground;html=1;" vertex="1" parent="1"><mxGeometry x="1458" y="590" width="24" height="18" as="geometry"/></mxCell><mxCell id="c113" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="630" as="sourcePoint"/><mxPoint x="1230" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c114" value="" style="shape=mxgraph.electrical.resistors.resistor_2;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1230" y="622" width="70" height="16" as="geometry"/></mxCell><mxCell id="c115" value="R6 220 Ω" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1230" y="600" width="90" height="20" as="geometry"/></mxCell><mxCell id="c116" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="630" as="sourcePoint"/><mxPoint x="1340" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c117" value="" style="shape=mxgraph.electrical.opto_electronics.led_2;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1340" y="610" width="80" height="40" as="geometry"/></mxCell><mxCell id="c118" value="D2 LED green" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="588" width="120" height="20" as="geometry"/></mxCell><mxCell id="c119" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="630" as="sourcePoint"/><mxPoint x="1470" y="650" as="targetPoint"/><Array as="points"><mxPoint x="1470" y="630"/></Array></mxGeometry></mxCell><mxCell id="c120" value="" style="shape=mxgraph.electrical.signal_sources.signal_ground;html=1;" vertex="1" parent="1"><mxGeometry x="1458" y="650" width="24" height="18" as="geometry"/></mxCell><mxCell id="c121" value="&lt;b&gt;NOTES&lt;/b&gt;&lt;br&gt;1. Battery BT1 is the primary supply; PV1 only recharges it through U1.&lt;br&gt;2. All grounds are common. Use a common-negative controller so BAT−, LOAD− and GND are one net.&lt;br&gt;3. U4 INA219 sits in series with BT1+ (VIN+ → VIN−): it reads battery voltage and charge / discharge current on the I²C bus.&lt;br&gt;4. I²C bus (IO21/IO22) is shared by J1 (0x69) and U4 (0x40). R3/R4 pull up to 3.3 V; SEN55 I/O is 3.3 V compatible.&lt;br&gt;5. Place C2 close to U3 5V pin to absorb LTE transmit current peaks (~2 A).&lt;br&gt;6. Use only the free header pins shown; the pins listed inside U3 are wired on the board.&lt;br&gt;7. PV and battery wiring ≥ 18 AWG; SEN55 cable kept short." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#000000;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="560" height="320" as="geometry"/></mxCell><mxCell id="c122" value="&lt;b&gt;BILL OF MATERIALS&lt;/b&gt;&lt;br&gt;PV1 — Solar panel 20 W, 12 V class&lt;br&gt;U1 — Solar charge controller 12 V 10 A (LiFePO4)&lt;br&gt;F1 — Blade/glass fuse 5 A + holder&lt;br&gt;BT1 — LiFePO4 battery 12.8 V 6 Ah&lt;br&gt;U2 — DC-DC buck module 12 V → 5 V, 3 A&lt;br&gt;C2 — Electrolytic capacitor 1000 µF 16 V&lt;br&gt;U3 — LilyGO T-SIM7600 (SIM7600G-H) + nano-SIM&lt;br&gt;ANT1 — 4G LTE antenna, SMA + IPEX pigtail&lt;br&gt;U4 — INA219 current/voltage sensor module&lt;br&gt;J1 — Sensirion SEN55 + JST GHR-06V cable&lt;br&gt;R3, R4 — 4.7 kΩ · R5, R6 — 220 Ω&lt;br&gt;D1, D2 — 5 mm LED red / green" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#000000;spacing=10;" vertex="1" parent="1"><mxGeometry x="610" y="780" width="520" height="320" as="geometry"/></mxCell><mxCell id="c123" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;4&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot;&gt;&lt;b&gt;Title:&lt;/b&gt; Ginhawa Monitoring Station — Circuit Schematic&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Project:&lt;/b&gt; Ginhawa IoT air-quality monitor&lt;/td&gt;&lt;td&gt;&lt;b&gt;Sheet:&lt;/b&gt; 1 / 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Drawn by:&lt;/b&gt; ____________&lt;/td&gt;&lt;td&gt;&lt;b&gt;Rev:&lt;/b&gt; A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Checked by:&lt;/b&gt; ____________&lt;/td&gt;&lt;td&gt;&lt;b&gt;Date:&lt;/b&gt; 2026-09-26&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1150" y="900" width="520" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>